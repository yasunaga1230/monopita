---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProductCard from '../components/ProductCard.astro';
import { CATEGORIES, type CategorySlug, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'posts'>['data'];

const { title, description, pubDate, updatedDate, category, tags, products } = Astro.props;
const categoryName = CATEGORIES[category as CategorySlug] || category;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
  </head>
  <body>
    <Header />
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
      <article>
        <div class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <a
              href={`/category/${category}`}
              class="inline-block px-3 py-1 text-xs font-medium bg-teal-50 text-primary rounded-full no-underline hover:bg-teal-100 transition-colors"
            >
              {categoryName}
            </a>
            <span class="text-sm text-gray-400">
              <FormattedDate date={pubDate} />
            </span>
            {updatedDate && (
              <span class="text-sm text-gray-400">
                （更新: <FormattedDate date={updatedDate} />）
              </span>
            )}
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight mb-4">{title}</h1>
          <p class="text-gray-500 text-base">{description}</p>
        </div>

        <div class="prose">
          <slot />
        </div>

        {products && products.length > 0 && (
          <div class="mt-12 pt-8 border-t border-gray-200">
            <h2 class="text-xl font-bold text-gray-900 mb-6">この記事で紹介した商品</h2>
            {products.map((product) => (
              <ProductCard
                name={product.name}
                asin={product.asin}
                price={product.price}
                description={product.description}
                rating={product.rating}
              />
            ))}
          </div>
        )}
      </article>
    </main>
    <Footer />
  </body>
</html>
