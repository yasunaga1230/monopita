---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProductCard from '../components/ProductCard.astro';
import { CATEGORIES, type CategorySlug, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'posts'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags, products } = Astro.props;
const categoryName = CATEGORIES[category as CategorySlug] || category;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
  </head>
  <body>
    <Header />

    {heroImage && (
      <div class="site-container" style="margin-top:2rem;">
        <img
          src={heroImage}
          alt={title}
          style="width:100%;height:auto;border-radius:0.75rem;object-fit:cover;aspect-ratio:2/1;"
        />
      </div>
    )}

    <main class="site-container page-content">
      <article>
        <div class="article-header">
          <div class="article-meta">
            <a
              href={`/category/${category}`}
              style="display:inline-block;padding:0.25rem 0.75rem;font-size:0.75rem;font-weight:500;background:#f0fdfa;color:#0D9488;border-radius:9999px;text-decoration:none;"
            >
              {categoryName}
            </a>
            <span style="font-size:0.875rem;color:#9ca3af;">
              <FormattedDate date={pubDate} />
            </span>
            {updatedDate && (
              <span style="font-size:0.875rem;color:#9ca3af;">
                （更新: <FormattedDate date={updatedDate} />）
              </span>
            )}
          </div>
          <h1>{title}</h1>
          <p class="article-description">{description}</p>
        </div>

        {tags && tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span style="font-size:0.75rem;color:#6b7280;background:#f3f4f6;padding:0.25rem 0.625rem;border-radius:9999px;">#{tag}</span>
            ))}
          </div>
        )}

        <div class="prose">
          <slot />
        </div>

        {products && products.length > 0 && (
          <div class="article-products">
            <h2>この記事で紹介した商品</h2>
            {products.map((product) => (
              <ProductCard
                name={product.name}
                asin={product.asin}
                price={product.price}
                description={product.description}
                rating={product.rating}
              />
            ))}
          </div>
        )}

        <div class="article-disclaimer">
          <p>
            ※ 価格は記事公開時点のものです。最新の価格はAmazon商品ページでご確認ください。<br/>
            ※ 当サイトはAmazonアソシエイト・プログラムに参加しています。
          </p>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
