---
import { SITE_TITLE, CATEGORIES } from '../consts';

const pathname = Astro.url.pathname;
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 no-underline">
        <span class="text-2xl font-bold text-primary">MonoPita</span>
        <span class="hidden sm:inline text-xs text-gray-400 mt-1">モノピタ</span>
      </a>

      <nav class="hidden md:flex items-center gap-6">
        <a
          href="/"
          class:list={[
            'text-sm font-medium transition-colors hover:text-primary no-underline',
            pathname === '/' ? 'text-primary' : 'text-gray-600',
          ]}
        >
          ホーム
        </a>
        {Object.entries(CATEGORIES).slice(0, 4).map(([slug, name]) => (
          <a
            href={`/category/${slug}`}
            class:list={[
              'text-sm font-medium transition-colors hover:text-primary no-underline',
              pathname === `/category/${slug}/` ? 'text-primary' : 'text-gray-600',
            ]}
          >
            {name}
          </a>
        ))}
      </nav>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-gray-600 hover:text-primary"
        aria-label="メニューを開く"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <nav class="px-4 py-3 space-y-2">
      <a href="/" class="block py-2 text-sm font-medium text-gray-600 hover:text-primary no-underline">ホーム</a>
      {Object.entries(CATEGORIES).map(([slug, name]) => (
        <a
          href={`/category/${slug}`}
          class="block py-2 text-sm font-medium text-gray-600 hover:text-primary no-underline"
        >
          {name}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
