---
import { SITE_TITLE, CATEGORIES } from '../consts';

const pathname = Astro.url.pathname;
---

<header class="bg-white/95 backdrop-blur-sm border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 sm:px-10">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 no-underline group">
        <img src="/logo.svg" alt="MonoPita" class="w-9 h-9 group-hover:scale-105 transition-transform" />
        <div class="flex flex-col leading-tight">
          <span class="text-xl font-bold text-gray-900 tracking-tight">MonoPita</span>
          <span class="text-[10px] text-gray-400 -mt-0.5">あなたにぴったりのモノを</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-1">
        <a
          href="/"
          class:list={[
            'px-3 py-1.5 text-sm font-medium rounded-full transition-all no-underline',
            pathname === '/' ? 'text-primary bg-teal-50' : 'text-gray-600 hover:text-primary hover:bg-gray-50',
          ]}
        >
          ホーム
        </a>
        {Object.entries(CATEGORIES).slice(0, 4).map(([slug, name]) => (
          <a
            href={`/category/${slug}`}
            class:list={[
              'px-3 py-1.5 text-sm font-medium rounded-full transition-all no-underline',
              pathname === `/category/${slug}/` ? 'text-primary bg-teal-50' : 'text-gray-600 hover:text-primary hover:bg-gray-50',
            ]}
          >
            {name}
          </a>
        ))}
      </nav>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-gray-600 hover:text-primary rounded-lg hover:bg-gray-50 transition-colors"
        aria-label="メニューを開く"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <nav class="px-4 py-3 space-y-1">
      <a href="/" class="block py-2.5 px-3 text-sm font-medium text-gray-600 hover:text-primary hover:bg-teal-50 rounded-lg no-underline transition-colors">ホーム</a>
      {Object.entries(CATEGORIES).map(([slug, name]) => (
        <a
          href={`/category/${slug}`}
          class="block py-2.5 px-3 text-sm font-medium text-gray-600 hover:text-primary hover:bg-teal-50 rounded-lg no-underline transition-colors"
        >
          {name}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
