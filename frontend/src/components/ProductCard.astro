---
import { AMAZON_ASSOCIATE_TAG } from '../consts';

interface Props {
  name: string;
  asin: string;
  price: string;
  description: string;
  rating?: number;
}

const { name, asin, price, description, rating } = Astro.props;
const amazonUrl = `https://www.amazon.co.jp/dp/${asin}?tag=${AMAZON_ASSOCIATE_TAG}`;

const fullStars = rating ? Math.floor(rating) : 0;
const hasHalf = rating ? rating - fullStars >= 0.5 : false;
const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
---

<div class="product-card">
  <div class="product-card-inner">
    <div class="product-icon-area">
      <svg viewBox="0 0 24 24" fill="none" class="product-icon">
        <rect x="2" y="3" width="20" height="18" rx="2" stroke="#0D9488" stroke-width="1.5"/>
        <path d="M8 7h8M8 11h5" stroke="#0D9488" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="16" cy="16" r="3" fill="#0D9488" opacity="0.15" stroke="#0D9488" stroke-width="1.5"/>
        <path d="M15 16l1 1 2-2" stroke="#0D9488" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="product-info">
      <h4 class="product-name">
        <a href={amazonUrl} target="_blank" rel="noopener noreferrer nofollow">{name}</a>
      </h4>
      <p class="product-description">{description}</p>
      <div class="product-meta">
        <span class="product-price">{price}</span>
        {rating && (
          <span class="product-rating">
            <span class="stars">
              {Array.from({ length: fullStars }).map(() => <span class="star-filled">★</span>)}
              {hasHalf && <span class="star-filled">★</span>}
              {Array.from({ length: emptyStars }).map(() => <span class="star-empty">★</span>)}
            </span>
            <span class="rating-number">({rating})</span>
          </span>
        )}
      </div>
      <a
        href={amazonUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="product-button"
      >
        Amazonで見る →
      </a>
    </div>
  </div>
</div>

<style>
  .product-card {
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1.5rem;
    background: #fafafa;
    margin-bottom: 1.75rem;
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .product-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    border-color: #d1d5db;
  }
  .product-card:last-child {
    margin-bottom: 0;
  }
  .product-card-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .product-icon-area {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    background: #f0fdfa;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-icon {
    width: 28px;
    height: 28px;
  }
  .product-info {
    flex: 1;
    min-width: 0;
  }
  .product-name {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
  }
  .product-name a {
    color: #111827;
    text-decoration: none;
  }
  .product-name a:hover {
    color: #0D9488;
  }
  .product-description {
    font-size: 0.875rem;
    color: #4b5563;
    margin: 0 0 0.75rem 0;
    line-height: 1.6;
  }
  .product-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .product-price {
    font-size: 1.125rem;
    font-weight: 700;
    color: #111827;
  }
  .product-rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .stars {
    font-size: 0.875rem;
  }
  .star-filled {
    color: #f59e0b;
  }
  .star-empty {
    color: #d1d5db;
  }
  .rating-number {
    font-size: 0.75rem;
    color: #6b7280;
  }
  .product-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: #FF9900;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.2s;
  }
  .product-button:hover {
    background: #E68A00;
  }
  @media (max-width: 640px) {
    .product-card-inner {
      flex-direction: row;
    }
    .product-icon-area {
      width: 48px;
      height: 48px;
    }
    .product-icon {
      width: 24px;
      height: 24px;
    }
  }
</style>
