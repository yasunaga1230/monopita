---
import { SITE_TITLE } from '../consts';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-container footer-inner">
    <div class="footer-grid">
      <div>
        <a href="/" style="display:flex;align-items:center;gap:0.5rem;text-decoration:none;">
          <img src="/logo.svg" alt="MonoPita" style="width:2rem;height:2rem;" />
          <span style="font-size:1.25rem;font-weight:700;color:#111827;">MonoPita</span>
        </a>
        <p style="margin-top:0.75rem;font-size:0.875rem;color:#6b7280;">あなたの暮らしに、ぴったりのモノを。</p>
      </div>
      <div>
        <h3 style="font-size:0.875rem;font-weight:600;color:#111827;margin-bottom:1rem;">カテゴリ</h3>
        <ul class="footer-list">
          <li><a href="/category/desk" style="font-size:0.875rem;color:#6b7280;text-decoration:none;">デスク周り・PC周辺</a></li>
          <li><a href="/category/kitchen" style="font-size:0.875rem;color:#6b7280;text-decoration:none;">キッチン便利グッズ</a></li>
          <li><a href="/category/cleaning" style="font-size:0.875rem;color:#6b7280;text-decoration:none;">掃除・収納</a></li>
          <li><a href="/category/smartphone" style="font-size:0.875rem;color:#6b7280;text-decoration:none;">スマホ・モバイル</a></li>
        </ul>
      </div>
      <div>
        <h3 style="font-size:0.875rem;font-weight:600;color:#111827;margin-bottom:1rem;">サイト情報</h3>
        <ul class="footer-list">
          <li><a href="/about" style="font-size:0.875rem;color:#6b7280;text-decoration:none;">運営者情報</a></li>
          <li><a href="/privacy" style="font-size:0.875rem;color:#6b7280;text-decoration:none;">プライバシーポリシー</a></li>
          <li><a href="/contact" style="font-size:0.875rem;color:#6b7280;text-decoration:none;">お問い合わせ</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p style="font-size:0.875rem;color:#9ca3af;">&copy; {currentYear} {SITE_TITLE}. All rights reserved.</p>
      <p style="font-size:0.75rem;color:#9ca3af;margin-top:0.25rem;">当サイトはAmazonアソシエイト・プログラムに参加しています。</p>
    </div>
  </div>
</footer>
