---
import { CATEGORIES, type CategorySlug } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: CategorySlug;
  slug: string;
  heroImage?: string;
}

const { title, description, pubDate, category, slug, heroImage } = Astro.props;
const categoryName = CATEGORIES[category] || category;
---

<article class="article-card">
  <a href={`/posts/${slug}`} class="article-card-link">
    <div class="article-card-inner">
      {heroImage && (
        <div class="article-card-image">
          <img
            src={heroImage}
            alt={title}
            loading="lazy"
          />
        </div>
      )}
      <div class="article-card-body">
        <div class="article-card-meta">
          <span class="article-card-category">{categoryName}</span>
          <span class="article-card-date">
            <FormattedDate date={pubDate} />
          </span>
        </div>
        <h3 class="article-card-title">{title}</h3>
        <p class="article-card-excerpt">{description}</p>
      </div>
    </div>
  </a>
</article>

<style>
  .article-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .article-card-inner {
    background: #fff;
    border-radius: 0.75rem;
    border: 1px solid #f3f4f6;
    overflow: hidden;
    transition: box-shadow 0.3s, transform 0.3s;
  }
  .article-card-link:hover .article-card-inner {
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .article-card-image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .article-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .article-card-link:hover .article-card-image img {
    transform: scale(1.05);
  }
  .article-card-body {
    padding: 1.25rem 1.25rem 1.5rem;
  }
  .article-card-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
  }
  .article-card-category {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: 0.7rem;
    font-weight: 500;
    background: #f0fdfa;
    color: #0D9488;
    border-radius: 9999px;
  }
  .article-card-date {
    font-size: 0.75rem;
    color: #9ca3af;
  }
  .article-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-card-link:hover .article-card-title {
    color: #0D9488;
  }
  .article-card-excerpt {
    font-size: 0.85rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
