---
import { CATEGORIES, type CategorySlug } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: CategorySlug;
  slug: string;
  heroImage?: string;
}

const { title, description, pubDate, category, slug, heroImage } = Astro.props;
const categoryName = CATEGORIES[category] || category;
---

<article class="group">
  <a href={`/posts/${slug}`} class="block no-underline">
    <div class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
      {heroImage && (
        <div class="aspect-[16/9] overflow-hidden">
          <img
            src={heroImage}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
        </div>
      )}
      <div class="p-5">
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-teal-50 text-primary rounded-full">
            {categoryName}
          </span>
          <span class="text-xs text-gray-400">
            <FormattedDate date={pubDate} />
          </span>
        </div>
        <h3 class="text-base font-semibold text-gray-900 mb-2 line-clamp-2 group-hover:text-primary transition-colors">
          {title}
        </h3>
        <p class="text-sm text-gray-500 line-clamp-2">{description}</p>
      </div>
    </div>
  </a>
</article>
